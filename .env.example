# =============================================================================
# Copy this file to .env and fill in the blanks. Everything not marked
# "FILL THIS IN" already has a sensible default and can be left as-is for
# local development. Full explanation of every setting is in README.md.
# =============================================================================

# --- Database ---
# "localhost" if running natively; change to "db" (the Postgres service name
# in docker-compose.yml) if running via `docker compose` instead.
DATABASE_URL=postgresql+psycopg2://mpn_user:mpn_pass@localhost:5432/mpn_db
TEST_DATABASE_URL=postgresql+psycopg2://mpn_user:mpn_pass@localhost:5432/mpn_test_db

# --- Redis ---
# Same rule: "redis" instead of "localhost" under Docker.
REDIS_URL=redis://localhost:6379/0

# --- JWT signing key ---
# FILL THIS IN — generate your own, don't reuse this placeholder or anyone
# else's: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# --- Email sending ---
# "console" (default): emails are just logged, not sent — nothing to fill
# in, safe out of the box. Switch to "smtp" and fill in the three lines
# below to send real email via Gmail:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password (choose "Mail"): https://myaccount.google.com/apppasswords
#      Google gives you a 16-character password — that's SMTP_PASSWORD,
#      NOT your normal Gmail password.
# Any other provider (Outlook, SendGrid's SMTP relay, etc.) works the same
# way, just change SMTP_HOST/PORT to that provider's values.
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

# FILL THIS IN (only if EMAIL_BACKEND=smtp) — your Gmail address
SMTP_USERNAME=

# FILL THIS IN (only if EMAIL_BACKEND=smtp) — the 16-character App Password
SMTP_PASSWORD=

# FILL THIS IN (only if EMAIL_BACKEND=smtp) — same Gmail address again
SMTP_FROM_EMAIL=

# --- SMS sending (optional — only for SMS-based 2FA) ---
# "console" (default): the code is just logged, not texted — nothing to
# fill in. Real SMS needs a paid Twilio number (the free trial no longer
# includes one) — see README.md for the walkthrough if you want this.
SMS_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
